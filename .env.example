# ============================================================
# App
# ============================================================
APP_ENV=development
APP_NAME=competitive-agent-system
API_HOST=0.0.0.0
API_PORT=8000

# ============================================================
# Database
# SQLite (default, MVP): sqlite:///./dev.db
# PostgreSQL (v1):        postgresql://user:pass@localhost:5432/competitive_db
# ============================================================
DATABASE_URL=sqlite:///./dev.db

# ============================================================
# LLM
# DEFAULT_MODEL options: gpt-4.1-mini | gpt-4o | deepseek-v4-flash | deepseek-v4-pro
# AnalystAgent and WriterAgent call OpenAI by default.
# Set ANTHROPIC_API_KEY if you switch DEFAULT_MODEL to a Claude model.
#
# OPENAI_BASE_URL: override the API endpoint for OpenAI-compatible providers
#   e.g. DeepSeek: https://api.deepseek.com
#   Leave blank to use the official OpenAI endpoint.
#
# LLM_DISABLE_THINKING: set true when using models that enable thinking by
#   default (e.g. deepseek-v4-pro). Thinking mode is incompatible with
#   function calling; this flag passes {"thinking": {"type": "disabled"}}.
# ============================================================
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
DEFAULT_MODEL=deepseek-v4-flash
LLM_DISABLE_THINKING=false

# ============================================================
# LangSmith (optional — workflow tracing dashboard)
# Sign up at https://smith.langchain.com to get an API key.
# Set LANGSMITH_TRACING=true to enable trace upload.
# ============================================================
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=competitive-agent-system

# ============================================================
# Data collection
# ENABLE_LIVE_SEARCH=true    → Prefer real search/crawl when Tavily is configured
#   (default; falls back to fixtures when unavailable or insufficient)
# ENABLE_LIVE_SEARCH=false   → Force demo/offline fixture path
# ENABLE_DEMO_FIXTURES=true  → Allow CollectorAgent to read from
#   scripts/demo_fixtures/*.json as a stable fallback
# TAVILY_API_KEY             → enables Tavily web search for
#   additional URL discovery (requires ENABLE_LIVE_SEARCH=true)
# ============================================================
ENABLE_DEMO_FIXTURES=true
ENABLE_LIVE_SEARCH=true
TAVILY_API_KEY=

# ============================================================
# Frontend (Next.js)
# ============================================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ============================================================
# Runtime
# MAX_REPAIR_LOOPS: how many times QAAgent can reject and
#   re-route the workflow before marking the project qa_failed
# ============================================================
AGENT_TIMEOUT_SECONDS=60
MAX_REPAIR_LOOPS=1
LOG_LEVEL=INFO
